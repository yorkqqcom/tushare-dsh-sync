{
  "name": "dsh-tushare-sync",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：Tushare 日更下载管理（SQLite/PostgreSQL、步骤 UI、定时任务）",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "engine",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tushare",
    "sqlite",
    "postgresql"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorkqqcom/tushare-dsh-sync.git"
  },
  "homepage": "https://github.com/yorkqqcom/tushare-dsh-sync#readme",
  "bugs": {
    "url": "https://github.com/yorkqqcom/tushare-dsh-sync/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build && node scripts/clean-pack-junk.mjs engine",
    "pack:release": "npm pack",
    "test": "npm run build && node test/smoke.mjs",
    "check": "node --check lib/index.js",
    "engine:help": "python -m tushare_engine.cli --help"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
